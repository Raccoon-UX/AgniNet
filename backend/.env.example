# AgniNet Backend Environment Configuration
# ==========================================

# 1. NASA FIRMS MAP_KEY (Required for Live Telemetry)
# Get your free key at: https://firms.modaps.eosdis.nasa.gov/api/map_key/
# If left blank or unset, AgniNet will automatically run in clearly labelled DEMO mode.
NASA_FIRMS_MAP_KEY=

# 2. Performance & Caching Settings
CACHE_TTL_SECONDS=300
REQUEST_TIMEOUT_SECONDS=15.0
MAX_RECORDS_PER_RESPONSE=2500

# 3. Server Configuration
ENVIRONMENT=development
DEBUG=false
